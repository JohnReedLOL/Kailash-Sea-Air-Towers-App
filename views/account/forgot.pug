extends ../layout

block content
  .col-sm-8.offset-sm-2
    form(method='POST')
      legend Forgot Password
      hr
      input(type='hidden', name='_csrf', value=_csrf)
      .form-group
        p Enter your email address below and we will send you a link to reset your password.
        label.col-form-label.font-weight-bold(for='email') Email
        input.form-control(type='email', name='email', id='email', placeholder='Email', autofocus, required)
        small.form-text.text-muted.mt-2
          i.fa.fa-info-circle
          |  Please also check your #[strong Spam] or #[strong Junk] folder if you do not see the reset email in your inbox.
      .form-group
        button.btn.btn-primary(type='submit')
          i.fa.fa-key
          |  Reset Password
